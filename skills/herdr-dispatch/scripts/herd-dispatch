    "grok": "--model",
    "cursor": "--model",
    "claude": "--model",
    "codex": "--model",
    "pi": "--model",
    "gemini": "--model",
}
# Local catalog commands. Parsers consume stdout of argv after the binary.
MODEL_PROBES = {
    "grok": {"argv": ["models"], "parser": "grok"},
    "cursor": {"argv": ["--list-models"], "parser": "cursor"},
    "claude": {"argv": ["models"], "parser": "claude"},
    "codex": {"argv": ["debug", "models"], "parser": "codex"},
    "pi": {"argv": ["--list-models"], "parser": "pi"},
}
HERDR_SETTLED = {"idle", "done"}
