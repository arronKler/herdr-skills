from typing import Any

from dispatch_store import (
    begin_generation, expected_generation, generation_path, index_lock, job_dir,
    job_lock, load_index, put_job, save_index, sidecar_path, store_dir,
)

NAME_RE = re.compile(r"^[a-z][a-z0-9_-]{0,31}$")
