KIND_ALIASES = {
    "grok-build": "grok",
    "grokbuild": "grok",
    "cursor-agent": "cursor",
}
# herdr agent start executable when it differs from the kind name.
KIND_BINARIES = {
    "cursor": "cursor-agent",
}
# Native start flag for --model. Kinds omitted here need --args.
